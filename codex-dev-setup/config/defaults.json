{
  "schemaVersion": 1,
  "scriptVersion": "1.0.0",
  "profileName": "personal-multi-device",
  "preferences": {
    "language": "zh-CN-with-English-terms",
    "agentStrategy": "AutoRecommendConfirm",
    "terminalStrategy": "MatchAgent",
    "moduleConfirmation": true,
    "firstRunWhatIf": true,
    "updatePolicy": "CheckAndPrompt",
    "failurePolicy": "ClassifyAndContinue"
  },
  "paths": {
    "windowsProjects": "%USERPROFILE%\\source",
    "wslProjects": "~/code",
    "projectPath": ""
  },
  "codex": {
    "installOrUpdateDesktop": true,
    "approvalPolicy": "on-request",
    "sandboxMode": "workspace-write",
    "windowsSandbox": "unelevated",
    "networkAccess": true,
    "webSearch": "live",
    "model": "",
    "reasoningEffort": "high",
    "personality": "pragmatic",
    "checkForUpdateOnStartup": true,
    "shareWindowsHomeToWsl": false,
    "manageMcpPluginsSkills": false
  },
  "git": {
    "provider": "GitHub",
    "authentication": "Mixed",
    "configureWindowsGit": true,
    "credentialAndSshGuidanceOnly": true,
    "moveExistingRepositories": false
  },
  "toolchains": {
    "node": {
      "enabled": true,
      "manager": "fnm",
      "channel": "lts"
    },
    "python": {
      "enabled": true,
      "manager": "uv",
      "version": "latest-supported"
    }
  },
  "projectTemplates": {
    "enabled": true,
    "files": [
      "AGENTS.md",
      ".codex/config.toml",
      ".editorconfig",
      ".gitattributes",
      ".gitignore"
    ],
    "overwriteExistingWithoutConfirmation": false
  },
  "interviewAnswers": {
    "1": "B",
