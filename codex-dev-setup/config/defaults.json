{
  "schemaVersion": 2,
  "environmentMode": "WslFirst",
  "preferences": {
    "moduleConfirmation": "Prompt",
    "firstRunWhatIf": false,
    "updatePolicy": "CheckOnly"
  },
  "paths": {
    "windowsProjects": "%USERPROFILE%\\source",
    "wslProjects": "~/code",
    "projectPath": ""
  },
  "windows": {
    "installDesktop": true,
    "installTerminal": true,
    "installUiGit": true,
    "installGitHubCli": true
  },
  "codex": {
    "approvalPolicy": "on-request",
    "sandboxMode": "workspace-write",
    "windowsSandbox": "elevated",
    "networkAccess": true,
    "webSearch": "live",
    "checkForUpdateOnStartup": true
  },
  "wsl": {
    "distribution": "Ubuntu-24.04",
    "ensureLatest": true,
    "installCodexCli": true,
    "installPnpm": true,
    "configureGit": true,
    "packages": [
      "build-essential",
      "ca-certificates",
      "curl",
      "fd-find",
      "gh",
      "git",
      "jq",
      "ripgrep",
      "shellcheck",
      "shfmt",
      "unzip"
    ],
    "aliases": {
      "fd": "fdfind"
    },
    "networking": {
      "enabled": true,
      "manageWslConfig": true,
      "networkingMode": "mirrored",
      "dnsTunneling": true,
      "autoProxy": true,
      "firewall": true
    }
  },
  "toolchains": {
    "node": {
      "enabled": true
    },
    "python": {
      "enabled": true
    },
    "docker": {
      "enabled": false,
      "provider": "DockerDesktop"
    }
  },
  "projectTemplates": {
    "enabled": true
  }
}
